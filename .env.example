# develyst-line-bot — every key, one line each. Copy to .env and fill; the real .env is git-ignored and agents never open it.
# LINE Messaging API channel secret: verifies that a webhook really came from LINE (X-Line-Signature).
LINE_CHANNEL_SECRET=
# LINE channel access token (long-lived): lets the bot push messages to the group.
LINE_CHANNEL_ACCESS_TOKEN=
# Where pushes go. EMPTY (the default) = the bot makes NO outside call at all and /send answers 503 NOT_CONFIGURED. On the server set https://api.line.me
LINE_API_BASE=
# A long random key. The desk's send command (scripts/send.ts) must present it as "Authorization: Bearer <key>". Empty = /send refuses everything.
SEND_KEY=
# This service's own public HTTPS origin, e.g. https://line-bot.example.com (no trailing slash). Image URLs sent to LINE are built from it.
PUBLIC_BASE_URL=
# Port the service listens on.
PORT=3100
# Where the joined group id and the uploaded images are kept (git-ignored). Default ./data
DATA_DIR=./data
# Record the SOM SYSTEM group's messages (phase 2). Set to true ONLY after the owner has told the group that the bot is in it and records messages for the project. Anything else = nothing is stored.
RECORD_GROUP_MESSAGES=
# How many days a recorded message is kept; older ones are dropped on every write. Default 90.
MESSAGE_RETENTION_DAYS=90
